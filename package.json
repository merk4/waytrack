{
  "name": "waymark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "fixture:vironas": "node --env-file=.env scripts/record-vironas-fixture.ts",
    "test:live": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "fixtures:providers": "node --env-file=.env scripts/capture-provider-fixtures.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.4",
    "@tanstack/react-query": "5.104.4",
    "geotiff": "3.0.5",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@netlify/functions": "6.0.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
